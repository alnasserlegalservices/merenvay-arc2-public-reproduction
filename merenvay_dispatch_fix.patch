 % Allow arc2_induce_rule/2 clauses at non-consecutive positions.
 :- discontiguous arc2_induce_rule/2.
 
+% ---------------------------------------------------------------------------
+% MERENVAY PRIORITY DISPATCH - public benchmark runtime stability repair
+% Moves six already-existing verified rules ahead of expensive generic search.
+% All gates are O(cells); transformation semantics and task data are unchanged.
+% ---------------------------------------------------------------------------
+
+arc2_induce_rule(TrainingPairs, mirror_patch) :-
+    TrainingPairs = [pair(In0, Out0)|_],
+    mp_bbox8_(In0, R1, R2, C1, C2),
+    length(Out0, OH), OH =:= R2 - R1 + 1,
+    Out0 = [ORow0|_], length(ORow0, OW), OW =:= C2 - C1 + 1,
+    flatten(Out0, FlatOut), \+ memberchk(8, FlatOut),
+    forall(member(pair(In, Out), TrainingPairs),
+           arc2_transform(mirror_patch, In, Out)).
+
+arc2_induce_rule(TrainingPairs, template_expand) :-
+    TrainingPairs = [pair(In0, Out0)|_],
+    length(In0, H), H >= 20, In0 = [IRow0|_], length(IRow0, W), W >= 20,
+    length(Out0, H), Out0 = [ORow0|_], length(ORow0, W),
+    arc2_te_bg_(In0, BG),
+    arc2_te_templ_cells_(In0, BG, H, W, TemplateCells),
+    length(TemplateCells, NTemplate), NTemplate >= 4,
+    forall(member(pair(In, Out), TrainingPairs),
+           arc2_transform(template_expand, In, Out)).
+
+arc2_induce_rule(TrainingPairs, constellation) :-
+    TrainingPairs = [pair(In0, Out0)|_],
+    length(In0, H), H >= 15, H =< 20,
+    In0 = [IRow0|_], length(IRow0, W), W >= 15, W =< 20,
+    length(Out0, H), Out0 = [ORow0|_], length(ORow0, W),
+    arc2_cst_prefilter_(In0, Out0),
+    length(TrainingPairs, NP),
+    include([pair(In, Out)]>>arc2_transform(constellation, In, Out), TrainingPairs, OK),
+    length(OK, NOK), NOK * 2 > NP.
+
+arc2_induce_rule(TrainingPairs, mosaic_heal) :-
+    TrainingPairs = [pair(In0, Out0)|_],
+    length(In0, 30), In0 = [IRow0|_], length(IRow0, 30),
+    length(Out0, 30), Out0 = [ORow0|_], length(ORow0, 30),
+    flatten(In0, FIn), memberchk(0, FIn),
+    sort(FIn, InColors), length(InColors, NColors), NColors >= 8,
+    flatten(Out0, FOut), \+ memberchk(0, FOut),
+    forall(member(pair(In, Out), TrainingPairs),
+           arc2_transform(mosaic_heal, In, Out)).
+
+arc2_induce_rule(TrainingPairs, hole_color) :-
+    TrainingPairs = [pair(In0, Out0)|_],
+    length(In0, 30), In0 = [IRow0|_], length(IRow0, 30),
+    length(Out0, 30), Out0 = [ORow0|_], length(ORow0, 30),
+    flatten(In0, FIn), memberchk(5, FIn),
+    sort(FIn, InColors), length(InColors, NColors), NColors =< 6,
+    include(==(0), FIn, Zeros), length(Zeros, NZ), length(FIn, NT), NZ * 2 > NT,
+    flatten(Out0, FOut), \+ memberchk(5, FOut),
+    forall(member(pair(In, Out), TrainingPairs),
+           arc2_transform(hole_color, In, Out)).
+
+arc2_induce_rule(TrainingPairs, frame_compass) :-
+    TrainingPairs = [pair(In0, Out0)|_],
+    length(In0, 22), In0 = [IRow0|_], length(IRow0, 22),
+    length(Out0, OH), Out0 = [ORow0|_], length(ORow0, OW),
+    OH < 22, OW < 22,
+    fc_has_solid_side_(In0),
+    forall(member(pair(In, Out), TrainingPairs),
+           arc2_transform(frame_compass, In, Out)).
+
 % ---------------------------------------------------------------------------
 % TRANSFORM REGISTRY
 % arc2_named_rule(+RuleName) — enumerate all known transform names.
